{
  "name": "earworm",
  "displayName": "Earworm",
  "description": "Control Spotify from VS Code: the desktop app on macOS, Linux and Windows with no sign-in, or any device plus search and your library through the Spotify Web API.",
  "icon": "images/icon.png",
  "version": "0.6.1",
  "publisher": "alenfrancis",
  "author": {
    "name": "Alen Francis"
  },
  "license": "MIT",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/me-alen/earworm-vscode.git"
  },
  "bugs": {
    "url": "https://github.com/me-alen/earworm-vscode/issues"
  },
  "qna": "https://github.com/me-alen/earworm-vscode/issues/new/choose",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "spotify",
    "music",
    "player",
    "status bar"
  ],
  "extensionKind": [
    "ui"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/src/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "earworm.search",
        "title": "Search Spotify",
        "category": "Earworm",
        "icon": "$(search)"
      },
      {
        "command": "earworm.pickDevice",
        "title": "Choose Spotify Device",
        "category": "Earworm",
        "icon": "$(broadcast)"
      },
      {
        "command": "earworm.toggleLike",
        "title": "Like/Unlike Current Song",
        "category": "Earworm",
        "icon": "$(heart)"
      },
      {
        "command": "earworm.playPause",
        "title": "Play/Pause",
        "category": "Earworm"
      },
      {
        "command": "earworm.next",
        "title": "Next Track",
        "category": "Earworm"
      },
      {
        "command": "earworm.previous",
        "title": "Previous Track",
        "category": "Earworm"
      },
      {
        "command": "earworm.volumeUp",
        "title": "Volume Up",
        "category": "Earworm"
      },
      {
        "command": "earworm.volumeDown",
        "title": "Volume Down",
        "category": "Earworm"
      },
      {
        "command": "earworm.toggleMute",
        "title": "Mute/Unmute",
        "category": "Earworm"
      },
      {
        "command": "earworm.toggleShuffle",
        "title": "Toggle Shuffle",
        "category": "Earworm"
      },
      {
        "command": "earworm.toggleRepeat",
        "title": "Toggle Repeat",
        "category": "Earworm"
      },
      {
        "command": "earworm.openSpotify",
        "title": "Open Spotify",
        "category": "Earworm"
      },
      {
        "command": "earworm.setUpWebApi",
        "title": "Set Up Spotify Web API",
        "category": "Earworm"
      },
      {
        "command": "earworm.openDashboard",
        "title": "Open Spotify Dashboard",
        "category": "Earworm"
      },
      {
        "command": "earworm.enterClientId",
        "title": "Paste Spotify Client ID",
        "category": "Earworm"
      },
      {
        "command": "earworm.signIn",
        "title": "Sign In to Spotify",
        "category": "Earworm"
      },
      {
        "command": "earworm.signOut",
        "title": "Sign Out of Spotify",
        "category": "Earworm"
      },
      {
        "command": "earworm.refreshLibrary",
        "title": "Refresh Library",
        "category": "Earworm",
        "icon": "$(refresh)"
      },
      {
        "command": "earworm.playItem",
        "title": "Play",
        "category": "Earworm",
        "icon": "$(play)"
      },
      {
        "command": "earworm.queueItem",
        "title": "Add to Queue",
        "category": "Earworm",
        "icon": "$(add)"
      },
      {
        "command": "earworm.customizeStatusBar",
        "title": "Customize Status Bar",
        "category": "Earworm",
        "icon": "$(settings-gear)"
      },
      {
        "command": "earworm.toggleStatusBarSide",
        "title": "Move Status Bar Items to the Other Side",
        "category": "Earworm",
        "icon": "$(arrow-swap)"
      },
      {
        "command": "earworm.sendFeedback",
        "title": "Send Feedback",
        "category": "Earworm",
        "icon": "$(feedback)"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "earworm",
          "title": "Earworm",
          "icon": "images/sidebar.svg"
        }
      ]
    },
    "views": {
      "earworm": [
        {
          "id": "earworm.library",
          "name": "Library"
        },
        {
          "id": "earworm.statusBar",
          "name": "Status Bar",
          "visibility": "collapsed"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "earworm.library",
        "when": "!earworm.signedIn",
        "contents": "See your queue, recently played, liked songs, playlists and albums here. The library uses the Spotify Web API, which needs your own free Spotify developer app and Spotify Premium.\n[Sign In to Spotify](command:earworm.signIn)\nNew to this? [Follow the steps](command:workbench.action.openWalkthrough?%22alenfrancis.earworm%23earworm.getStarted%22) one at a time."
      }
    ],
    "walkthroughs": [
      {
        "id": "earworm.getStarted",
        "title": "Get Started with Earworm",
        "description": "Control Spotify from the status bar, and optionally connect the Spotify Web API for every device, search and your library.",
        "steps": [
          {
            "id": "local",
            "title": "Play from the Spotify app",
            "description": "Earworm already works with the Spotify app on this computer: no sign-in, and Spotify Free is fine. Start a song in Spotify and it shows in the status bar.\n[Play/Pause](command:earworm.playPause)",
            "media": {
              "markdown": "walkthrough/local.md"
            },
            "completionEvents": [
              "onCommand:earworm.playPause"
            ]
          },
          {
            "id": "statusBar",
            "title": "Choose what the status bar shows",
            "description": "Tick the buttons, song name, heart and progress bar you want, and pick a side.\n[Customize Status Bar](command:earworm.customizeStatusBar)",
            "media": {
              "markdown": "walkthrough/status-bar.md"
            },
            "completionEvents": [
              "onCommand:earworm.customizeStatusBar",
              "onView:earworm.statusBar"
            ]
          },
          {
            "id": "createApp",
            "title": "Optional: create your Spotify app",
            "description": "For Spotify on any device, search and your library, Earworm uses the Spotify Web API. It needs Spotify Premium and your own free developer app. This button copies the redirect URI, then opens the dashboard.\n[Open Spotify Dashboard](command:earworm.openDashboard)",
            "media": {
              "markdown": "walkthrough/create-app.md"
            },
            "completionEvents": [
              "onCommand:earworm.openDashboard",
              "onContext:earworm.signedIn"
            ]
          },
          {
            "id": "signIn",
            "title": "Paste your Client ID and sign in",
            "description": "Copy the Client ID from your app's page, paste it here, then approve the sign-in in your browser.\n[Paste Client ID](command:earworm.enterClientId)",
            "media": {
              "markdown": "walkthrough/sign-in.md"
            },
            "completionEvents": [
              "onContext:earworm.signedIn"
            ]
          },
          {
            "id": "library",
            "title": "Browse your library",
            "description": "Your queue, recently played, liked songs, playlists and albums are in the Earworm sidebar, with search and device switching at the top.\n[Open the Library](command:earworm.library.focus)\nIdeas, or something not working? Tell us with **Earworm: Send Feedback**.\n[Send Feedback](command:earworm.sendFeedback)",
            "media": {
              "markdown": "walkthrough/library.md"
            },
            "completionEvents": [
              "onView:earworm.library"
            ]
          }
        ]
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "earworm.playItem",
          "when": "false"
        },
        {
          "command": "earworm.queueItem",
          "when": "false"
        },
        {
          "command": "earworm.openDashboard",
          "when": "false"
        },
        {
          "command": "earworm.enterClientId",
          "when": "false"
        }
      ],
      "view/title": [
        {
          "command": "earworm.search",
          "when": "view == earworm.library && earworm.signedIn",
          "group": "navigation@1"
        },
        {
          "command": "earworm.pickDevice",
          "when": "view == earworm.library && earworm.signedIn",
          "group": "navigation@2"
        },
        {
          "command": "earworm.refreshLibrary",
          "when": "view == earworm.library && earworm.signedIn",
          "group": "navigation@3"
        },
        {
          "command": "earworm.toggleStatusBarSide",
          "when": "view == earworm.statusBar",
          "group": "navigation@1"
        },
        {
          "command": "earworm.sendFeedback",
          "when": "view == earworm.library",
          "group": "z_feedback"
        }
      ],
      "view/item/context": [
        {
          "command": "earworm.queueItem",
          "when": "view == earworm.library && viewItem == song",
          "group": "inline"
        },
        {
          "command": "earworm.playItem",
          "when": "view == earworm.library && viewItem == collection",
          "group": "inline"
        },
        {
          "command": "earworm.playItem",
          "when": "view == earworm.library && viewItem =~ /song|collection/",
          "group": "1_play@1"
        },
        {
          "command": "earworm.queueItem",
          "when": "view == earworm.library && viewItem == song",
          "group": "1_play@2"
        }
      ]
    },
    "configuration": {
      "title": "Earworm",
      "properties": {
        "earworm.mode": {
          "type": "string",
          "enum": [
            "local",
            "webApi"
          ],
          "enumDescriptions": [
            "Control the Spotify app on this computer through the OS. No sign-in; works with Spotify Free.",
            "Control Spotify on any of your devices through the Spotify Web API. Needs your own Client ID and Spotify Premium. Set it up with \"Earworm: Set Up Spotify Web API\"."
          ],
          "default": "local",
          "description": "How Earworm talks to Spotify."
        },
        "earworm.clientId": {
          "type": "string",
          "default": "",
          "description": "Client ID of your own Spotify developer app, used in Web API mode. Not a secret. Set it with \"Earworm: Set Up Spotify Web API\"."
        },
        "earworm.refreshInterval": {
          "type": "number",
          "default": 2,
          "minimum": 1,
          "description": "Seconds between now-playing updates. Updates pause while the window is not focused. In Web API mode the minimum is 5 seconds, since every update counts against your Spotify quota."
        },
        "earworm.statusBar.items": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "previous": {
              "type": "boolean",
              "default": true,
              "description": "Previous track button"
            },
            "playPause": {
              "type": "boolean",
              "default": true,
              "description": "Play/Pause button"
            },
            "next": {
              "type": "boolean",
              "default": true,
              "description": "Next track button"
            },
            "nowPlaying": {
              "type": "boolean",
              "default": true,
              "description": "Song name and artist. Problems such as a needed sign-in still show here."
            },
            "like": {
              "type": "boolean",
              "default": true,
              "description": "Like button (heart). Shows only when signed in to the Spotify Web API."
            },
            "progress": {
              "type": "boolean",
              "default": true,
              "description": "Progress bar with the time played and the song's length."
            },
            "progressWhenPaused": {
              "type": "boolean",
              "default": false,
              "description": "Keep the progress bar while paused, to see where you stopped."
            }
          },
          "default": {
            "previous": true,
            "playPause": true,
            "next": true,
            "nowPlaying": true,
            "like": true,
            "progress": true,
            "progressWhenPaused": false
          },
          "markdownDescription": "Which Earworm items to show in the status bar. Also in the **Status Bar** section of the Earworm sidebar, and in **Earworm: Customize Status Bar**."
        },
        "earworm.statusBar.alignment": {
          "type": "string",
          "enum": [
            "left",
            "right"
          ],
          "default": "left",
          "enumDescriptions": [
            "Left side, next to the branch and problem counts.",
            "Right side, next to the language and notifications."
          ],
          "description": "Which side of the status bar Earworm's items sit on."
        },
        "earworm.showButtons": {
          "type": "boolean",
          "default": true,
          "description": "Show previous / play-pause / next buttons in the status bar.",
          "markdownDeprecationMessage": "Replaced by `#earworm.statusBar.items#`, which can show or hide each item.",
          "deprecationMessage": "Replaced by earworm.statusBar.items, which can show or hide each item."
        },
        "earworm.volumeStep": {
          "type": "number",
          "default": 10,
          "minimum": 1,
          "maximum": 50,
          "description": "How much Volume Up / Volume Down change the volume (0–100)."
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p .",
    "watch": "tsc -watch -p .",
    "test": "npm run compile && node --test \"out/test/**/*.test.js\"",
    "package": "npm run compile && npx --yes @vscode/vsce package"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.20.5",
    "@types/vscode": "1.90",
    "js-yaml": "^4.3.2",
    "typescript": "^7.0.2"
  }
}
