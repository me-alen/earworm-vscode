{
  "name": "backbeat",
  "displayName": "Backbeat",
  "description": "Control the Spotify desktop app from VS Code on macOS, Linux and Windows. No sign-in needed.",
  "icon": "images/icon.png",
  "version": "0.1.0",
  "publisher": "me-alen",
  "author": {
    "name": "Alen Francis"
  },
  "license": "UNLICENSED",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/me-alen/backbeat-vscode.git"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "spotify",
    "music",
    "player",
    "status bar"
  ],
  "extensionKind": [
    "ui"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/src/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "backbeat.playPause",
        "title": "Play/Pause",
        "category": "Backbeat"
      },
      {
        "command": "backbeat.next",
        "title": "Next Track",
        "category": "Backbeat"
      },
      {
        "command": "backbeat.previous",
        "title": "Previous Track",
        "category": "Backbeat"
      },
      {
        "command": "backbeat.volumeUp",
        "title": "Volume Up",
        "category": "Backbeat"
      },
      {
        "command": "backbeat.volumeDown",
        "title": "Volume Down",
        "category": "Backbeat"
      },
      {
        "command": "backbeat.toggleMute",
        "title": "Mute/Unmute",
        "category": "Backbeat"
      },
      {
        "command": "backbeat.toggleShuffle",
        "title": "Toggle Shuffle",
        "category": "Backbeat"
      },
      {
        "command": "backbeat.toggleRepeat",
        "title": "Toggle Repeat",
        "category": "Backbeat"
      },
      {
        "command": "backbeat.openSpotify",
        "title": "Open Spotify",
        "category": "Backbeat"
      },
      {
        "command": "backbeat.setUpWebApi",
        "title": "Set Up Spotify Web API",
        "category": "Backbeat"
      },
      {
        "command": "backbeat.signIn",
        "title": "Sign In to Spotify",
        "category": "Backbeat"
      },
      {
        "command": "backbeat.signOut",
        "title": "Sign Out of Spotify",
        "category": "Backbeat"
      }
    ],
    "configuration": {
      "title": "Backbeat",
      "properties": {
        "backbeat.mode": {
          "type": "string",
          "enum": [
            "local",
            "webApi"
          ],
          "enumDescriptions": [
            "Control the Spotify app on this computer through the OS. No sign-in; works with Spotify Free.",
            "Control Spotify on any of your devices through the Spotify Web API. Needs your own Client ID and Spotify Premium. Set it up with \"Backbeat: Set Up Spotify Web API\"."
          ],
          "default": "local",
          "description": "How Backbeat talks to Spotify."
        },
        "backbeat.clientId": {
          "type": "string",
          "default": "",
          "description": "Client ID of your own Spotify developer app, used in Web API mode. Not a secret. Set it with \"Backbeat: Set Up Spotify Web API\"."
        },
        "backbeat.refreshInterval": {
          "type": "number",
          "default": 2,
          "minimum": 1,
          "description": "Seconds between now-playing updates. Updates pause while the window is not focused. In Web API mode the minimum is 5 seconds, since every update counts against your Spotify quota."
        },
        "backbeat.showButtons": {
          "type": "boolean",
          "default": true,
          "description": "Show previous / play-pause / next buttons in the status bar."
        },
        "backbeat.volumeStep": {
          "type": "number",
          "default": 10,
          "minimum": 1,
          "maximum": 50,
          "description": "How much Volume Up / Volume Down change the volume (0–100)."
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p .",
    "watch": "tsc -watch -p .",
    "test": "npm run compile && node --test \"out/test/**/*.test.js\"",
    "package": "npm run compile && npx --yes @vscode/vsce package --skip-license"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/vscode": "1.90",
    "typescript": "^7.0.2"
  }
}
